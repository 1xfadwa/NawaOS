#include <stdio.h>
#include <stdlib.h>

// Function to perform the math calculation and print the result
void calculate(double a, char op, double b) {
    printf("mathematical calculations\n");
    switch (op) {
        case '+':
            printf(" Result: %.2f + %.2f = %.2f\n", a, b, a + b);
            break;
        case '-':
            printf(" Result: %.2f - %.2f = %.2f\n", a, b, a - b);
            break;
        case '*':
        case 'x':
            printf(" Result: %.2f * %.2f = %.2f\n", a, b, a * b);
            break;
        case '/':
            if (b == 0) {
                printf(" Error: Cannot divide by zero!\n");
            } else {
                printf(" Result: %.2f / %.2f = %.2f\n", a, b, a / b);
            }
            break;
        default:
            printf(" Error: Unknown operator '%c' (use +, -, *, /)\n", op);
    }
    

}

int main(int argc, char *argv[]) {
    double num1, num2;
    char operator;

    // Mode 1: Direct command arguments (e.g., calc 10 + 5)
    if (argc == 4) {
        num1 = atof(argv[1]);
        operator = argv[2][0];
        num2 = atof(argv[3]);
        calculate(num1, operator, num2);
        return 0;
    }

    // Mode 2: Interactive mode if user types 'calc' alone
    printf("\n*** NawaOS Calculator (v1.0) ***\n");
    printf("Enter expression (e.g., 12.5 * 4): ");
    if (scanf("%lf %c %lf", &num1, &operator, &num2) == 3) {
        calculate(num1, operator, num2);
    } else {
        printf("Invalid format! Usage: calc <num1> <op> <num2>\n\n");
    }

    return 0;
}
